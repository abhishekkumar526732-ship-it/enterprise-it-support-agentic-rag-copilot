# ═══════════════════════════════════════════════════════════════
# Enterprise IT Support Copilot — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── LLM Gateway (LiteLLM) ────────────────────────────────────
LITELLM_ENABLED=true
LITELLM_MODEL=gemini/gemini-3.8-flash
LITELLM_FALLBACK_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ── Embeddings (OpenAI) ──────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily Web Search ────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here

# ── Pinecone Vector Store ────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb

# ── JWT / OIDC / RBAC ───────────────────────────────────────
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# OIDC Provider (optional — uncomment to enable SSO)
# OIDC_ENABLED=true
# OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback

# ── NeMo Guardrails ─────────────────────────────────────────
GUARDRAILS_ENABLED=true

# ── AI Observability (LangSmith) ────────────────────────────
OBSERVABILITY_ENABLED=true
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=it-support-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# ── In-Memory Cache & Session (Redis) ────────────────────────
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional full URI override:
# REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── Long-Term Agent Memory (LangMem) ─────────────────────────
MEMORY_ENABLED=true
MEMORY_MAX_ITEMS=10

# ── Ragas Evaluation ────────────────────────────────────────
RAGAS_ENABLED=true

# ── Relational Database — PostgreSQL ─────────────────────────
POSTGRES_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=it_support_copilot
# Or provide a full connection URI to override host/port/credentials:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/it_support_copilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=3

# ── AWS Cloud Storage (S3 for production uploads) ─────────────
S3_ENABLED=false
S3_BUCKET_NAME=your-production-it-docs-bucket
AWS_REGION=us-east-1

# ── Production Concurrency (Gunicorn Workers) ────────────────
WEB_CONCURRENCY=8
GUNICORN_TIMEOUT=120

